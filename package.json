{
  "name": "lets-eat",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run db:migrate && npm run check:startup && next dev --hostname localhost",
    "build": "next build",
    "start": "next start --hostname localhost",
    "start:host": "npm run db:migrate && npm run check:startup && next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:release": "RUN_REAL_DEADLINE=1 playwright test",
    "prestart": "npm run db:migrate && npm run check:startup",
    "check:startup": "node --env-file-if-exists=.env.local scripts/check-startup.mjs",
    "test:hosted": "playwright test --config playwright.hosted.config.ts",
    "test:capacity": "node scripts/capacity.mjs",
    "db:backup:render": "node scripts/render-backup.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
